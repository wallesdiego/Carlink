    <string name="carlink_settings_root">Modo root</string>
    <string name="carlink_settings_root_detail">Para multimídias com root. Permite tudo o que a configuração pede sem janelas de aviso e mantém o Wi-Fi em modo de baixa latência enquanto um celular está conectado. Seu gerenciador de root pergunta uma vez.</string>
