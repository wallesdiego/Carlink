    <string name="carlink_settings_method_detail">Como o celular e o carro compartilham o Wi-Fi</string>
    <string name="carlink_settings_method_auto">Automático</string>
    <string name="carlink_settings_method_same_wifi">Mesmo Wi-Fi</string>
    <string name="carlink_settings_method_hotspot">Hotspot do carro</string>
    <string name="carlink_settings_method_direct">Wi-Fi Direct</string>
    <string name="carlink_settings_method_auto_detail">Escolhe o melhor caminho antes de cada conexão: mesmo Wi-Fi, depois o hotspot do carro, depois o Wi-Fi Direct.</string>
    <string name="carlink_settings_method_same_wifi_detail">Celular e carro no mesmo roteador, o caminho mais rápido. Precisa da senha do Wi-Fi uma vez.</string>
    <string name="carlink_settings_method_hotspot_detail">O celular entra no hotspot Wi-Fi que o carro cria. Funciona com qualquer celular.</string>
    <string name="carlink_settings_method_direct_detail">Uma conexão direta entre o celular e o carro. Não precisa de rede.</string>
    <string name="carlink_settings_method_sheet_body">O Bluetooth sempre inicia a conexão; depois a imagem e o som vão pelo Wi-Fi.</string>

    <string name="carlink_settings_hotspot">Hotspot do carro</string>
    <string name="carlink_settings_hotspot_detail">Nome e senha do hotspot do próprio carro</string>
    <string name="carlink_settings_hotspot_sheet_body">O CarLink lê esses dados do carro quando pode e os passa para o seu celular. Mude-os aqui e o CarLink muda também o hotspot do carro, quando o Android permite.</string>
    <string name="carlink_settings_hotspot_read">Ler do carro</string>
    <string name="carlink_settings_hotspot_reading">Lendo o hotspot do carro…</string>
    <string name="carlink_settings_hotspot_unreadable">Esta multimídia não deixa o CarLink ler o hotspot dela. Digite o nome e a senha exatamente como aparecem nas configurações de hotspot do carro.</string>
