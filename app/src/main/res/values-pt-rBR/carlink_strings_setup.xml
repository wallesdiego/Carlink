    <string name="carlink_setup_pair_name_label">Nome Bluetooth desta tela</string>
    <string name="carlink_setup_pair_name_unknown">Ligue o Bluetooth para ver</string>
    <string name="carlink_setup_pair_visible">Visível para celulares</string>
