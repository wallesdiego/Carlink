    <string name="carlink_setup_pair_external_bt">O modo sem fio ainda não está disponível nesta multimídia. Conecte o celular com um cabo USB — funciona do mesmo jeito.</string>
    <string name="carlink_setup_pair_wireless">Parear pelo Bluetooth</string>
    <string name="carlink_setup_pair_skip">Pular</string>
    <string name="carlink_setup_pair_cable_title">Conecte o celular nesta tela</string>
    <string name="carlink_setup_pair_cable_body">Use o cabo de carregar do celular na porta USB desta tela. Desbloqueie o celular; o CarLink começa sozinho.</string>
