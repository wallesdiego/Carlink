    <string name="carlink_setup_permission_optional">Opcional</string>
    <string name="carlink_setup_permission_recommended">Recomendado</string>
    <string name="carlink_setup_perm_bluetooth">Bluetooth</string>
    <string name="carlink_setup_perm_bluetooth_detail">Encontra e pareia seu celular, e o acorda para o modo sem fio</string>
    <string name="carlink_setup_perm_wifi">Dispositivos Wi-Fi por perto</string>
    <string name="carlink_setup_perm_wifi_detail">Cria a conexão Wi-Fi privada com o celular</string>
    <string name="carlink_setup_perm_location">Localização</string>
    <string name="carlink_setup_perm_location_detail">O Android exige para o Wi-Fi Direct; os mapas recebem a posição do carro</string>
    <string name="carlink_setup_perm_local_network">Rede local</string>
