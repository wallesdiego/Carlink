    <string name="carlink_setup_permissions_title">Permita o que o CarLink precisa</string>
    <string name="carlink_setup_permissions_body">O Android pede cada uma só uma vez. Permita as recomendadas agora para nada pedir enquanto você dirige; as opcionais podem esperar.</string>
    <string name="carlink_setup_permissions_all">Permitir tudo</string>
