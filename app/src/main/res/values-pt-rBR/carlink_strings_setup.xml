    <!-- Welcome -->
    <string name="carlink_setup_welcome_eyebrow">Boas-vindas</string>
    <string name="carlink_setup_welcome_title">Vamos conectar seu celular</string>
    <string name="carlink_setup_welcome_body">O CarLink roda o Apple CarPlay para iPhone e o Android Auto para celulares Android, por cabo ou sem fio. A configuração leva uns dois minutos.</string>
    <string name="carlink_setup_welcome_start">Começar</string>
    <string name="carlink_setup_plan_access">Permitir acesso</string>
    <string name="carlink_setup_plan_access_detail">Bluetooth, Wi-Fi e algumas opções, tudo de uma vez</string>
    <string name="carlink_setup_plan_car">Escolher o carro</string>
    <string name="carlink_setup_plan_car_detail">A marca dele; um BYD ganha os extras do DiLink</string>
    <string name="carlink_setup_plan_pair">Parear o celular</string>
    <string name="carlink_setup_plan_pair_detail">Uma vez, pelas configurações de Bluetooth do celular</string>

