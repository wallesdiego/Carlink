    <string name="carlink_setup_perm_microphone">Microfone</string>
    <string name="carlink_setup_perm_microphone_detail">Siri, Google Assistente e ligações</string>
    <string name="carlink_setup_perm_notifications">Notificações</string>
    <string name="carlink_setup_perm_notifications_detail">Mostra que o CarLink está conectado e permite pará-lo</string>
    <string name="carlink_setup_perm_overlay">Sobrepor a outros apps</string>
    <string name="carlink_setup_perm_overlay_detail">Permite que o CarLink abra sozinho quando o celular conecta</string>
    <string name="carlink_setup_perm_battery">Executar em segundo plano</string>
    <string name="carlink_setup_perm_battery_detail">Mantém a conexão quando a tela apaga</string>
    <string name="carlink_setup_perm_vpn">Conexão do CarPlay por cabo</string>
    <string name="carlink_setup_perm_vpn_detail">Permite que o CarPlay funcione pelo cabo USB. Nada vai para a internet por ela</string>

