    <string name="carlink_setup_pair_accept_android">Aceite o Android Auto no celular</string>
    <string name="carlink_setup_pair_accept_android_body">Siga as telas do Android Auto no %1$s e mantenha-o desbloqueado.</string>
    <string name="carlink_setup_pair_kind_title">%1$s está pareado</string>
    <string name="carlink_setup_pair_kind_body">É um iPhone ou um celular Android?</string>
    <string name="carlink_setup_pair_connected_title">%1$s está conectado</string>
    <string name="carlink_setup_pair_connected_body">O %1$s está rodando. Da próxima vez ele começa sozinho.</string>
    <string name="carlink_setup_pair_failed_title">Ainda não conectado</string>
    <string name="carlink_setup_pair_failed_body">O celular está pareado. Desbloqueie-o, confira se o Bluetooth e o Wi-Fi estão ligados e tente de novo.</string>
    <string name="carlink_setup_pair_bt_off_title">Ligue o Bluetooth</string>
    <string name="carlink_setup_pair_bt_off_body">Os celulares encontram esta tela pelo Bluetooth. Ligue-o para parear.</string>
    <string name="carlink_setup_pair_bt_on">Ligar o Bluetooth</string>
    <string name="carlink_setup_pair_cable">Conectar por cabo</string>
    <string name="carlink_setup_pair_other">Usar outro celular</string>
