    <string name="carlink_setup_pair_waiting_body">Mantenha esta tela aberta. Se o celular mostrar um código, confira se é igual ao daqui e toque em Parear.</string>
    <string name="carlink_setup_pair_pairing_title">Pareando com %1$s…</string>
    <string name="carlink_setup_pair_pairing_title_unnamed">Pareando com seu celular…</string>
