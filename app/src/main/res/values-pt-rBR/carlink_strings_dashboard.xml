    <string name="carlink_home_eyebrow_not_answering">Sem resposta</string>
    <string name="carlink_home_not_answering_title">Seu celular não está respondendo</string>
    <string name="carlink_home_not_answering_title_iphone">iPhone não alcançável pelo Bluetooth</string>
    <string name="carlink_home_not_answering_body_iphone">Desbloqueie o %1$s e confira se o Bluetooth dele está ligado, ou conecte-o com um cabo.</string>
    <string name="carlink_home_not_answering_body_usb">Desbloqueie o %1$s e aceite o aviso na tela dele. Se nada acontecer, desconecte o cabo e conecte de novo.</string>
    <string name="carlink_home_not_answering_body_android">Confira se o %1$s está com o Bluetooth ligado e desbloqueado, e mantenha-o perto desta tela. O Android Auto começa sozinho quando ele conectar.</string>
    <!-- Connection v2: pre-flight problems and precise failures. -->
    <string name="carlink_home_error_bt_off_title">O Bluetooth está desligado</string>
    <string name="carlink_home_error_bt_off_body">As conexões sem fio começam pelo Bluetooth. Ligue-o, ou conecte o celular com um cabo.</string>
    <string name="carlink_home_error_not_paired_title">Este celular não está pareado</string>
    <string name="carlink_home_error_not_paired_body">No celular, abra o Bluetooth e pareie com esta tela; depois tente de novo.</string>
    <!-- %1$s: the phone's Bluetooth name, or carlink_home_error_pairing_lost_phone. -->
    <string name="carlink_home_error_pairing_lost_title">%1$s precisa ser pareado de novo</string>
    <string name="carlink_home_error_pairing_lost_body">No celular, esqueça esta tela nas configurações de Bluetooth e pareie de novo.</string>
    <string name="carlink_home_error_pairing_lost_phone">Seu celular</string>
    <string name="carlink_home_open_bluetooth_settings">Abrir configurações de Bluetooth</string>
    <!-- A call while the stereo's own phone link or another app may hold the microphone (a toast over the projection). -->
    <string name="carlink_notice_call_microphone">O viva-voz da própria multimídia pode tomar o microfone. Atenda pela tela do CarPlay ou do Android Auto, ou desconecte o celular nas configurações de telefone da multimídia.</string>
    <string name="carlink_home_error_wifi_off_title">O Wi-Fi está desligado</string>
    <string name="carlink_home_error_wifi_off_body">A imagem vai pelo Wi-Fi. Ligue o Wi-Fi aqui; ele não precisa estar conectado a uma rede.</string>
    <string name="carlink_home_error_location_off_title">A localização está desligada</string>
    <string name="carlink_home_error_location_off_body">Com a localização desligada, o Android esconde os nomes de Wi-Fi e os dispositivos próximos, então a conexão sem fio não começa. Ligue-a e volte aqui.</string>
    <string name="carlink_home_error_permissions_title">Permissões necessárias</string>
    <string name="carlink_home_error_permissions_body">O CarLink precisa de Dispositivos próximos, Localização e Microfone para conectar seu celular.</string>
    <string name="carlink_home_error_overlay_title">Permita que o CarLink abra sobre outros apps</string>
    <string name="carlink_home_error_overlay_body">Assim o CarPlay ou o Android Auto aparecem assim que o celular conecta.</string>
    <string name="carlink_home_error_vpn_title">Permita a conexão do CarPlay</string>
    <string name="carlink_home_error_vpn_body">O CarPlay por cabo usa uma conexão privada. O Android pede uma vez para permiti-la.</string>
    <string name="carlink_home_error_refused_title">Seu celular não conseguiu entrar no Wi-Fi</string>
    <string name="carlink_home_error_refused_body">Confira a senha do Wi-Fi em Configurações, ou mude o tipo de conexão para Wi-Fi Direct.</string>
    <string name="carlink_home_error_unreached_title">Seu iPhone não conseguiu alcançar esta tela</string>
    <string name="carlink_home_error_unreached_body">Sua rede bloqueia a conexão de que o CarPlay precisa. Escolha o Wi-Fi Direct, ou conecte com um cabo.</string>
    <string name="carlink_home_error_weak_title">O sinal sem fio estava fraco demais</string>
    <string name="carlink_home_error_weak_body">Deixe o celular perto da tela e tente de novo, ou conecte com um cabo.</string>
    <string name="carlink_home_error_no_answer_title">Seu celular não respondeu</string>
    <string name="carlink_home_error_no_answer_body">Desbloqueie o celular, confira se o Bluetooth dele está ligado e conectado a esta tela, e tente de novo.</string>
    <string name="carlink_home_error_bluetooth_title">A conexão Bluetooth falhou</string>
    <string name="carlink_home_error_bluetooth_body">No celular, desligue e ligue o Bluetooth e tente de novo. Se continuar falhando, esqueça esta tela e pareie de novo.</string>
    <!-- The stereo's Bluetooth is an external module apps cannot use (detect/ExternalBluetoothProbe). -->
    <string name="carlink_home_error_external_bt_title">O modo sem fio ainda não está disponível nesta multimídia</string>
    <string name="carlink_home_error_external_module_title">Não foi possível acessar o módulo Bluetooth da multimídia</string>
    <string name="carlink_home_error_external_module_body">O modo sem fio pelo módulo Bluetooth da multimídia é experimental e não funcionou aqui. Numa multimídia FYT, desative primeiro o app “Car Link” da própria multimídia. Senão, conecte o celular com um cabo USB — funciona do mesmo jeito. Compartilhe o log do Diagnóstico para isso ser corrigido.</string>
    <string name="carlink_home_error_external_bt_body">O Bluetooth desta multimídia é um módulo separado que os apps não conseguem usar, então o CarPlay e o Android Auto não começam sem fio. Conecte o celular com um cabo USB — funciona do mesmo jeito.</string>
    <string name="carlink_home_how_to_connect">Como conectar</string>
    <string name="carlink_home_cable_title">Conectar com cabo USB</string>
    <string name="carlink_home_cable_body">1. Conecte o celular na porta USB da multimídia com um cabo que transmita dados (não um cabo só de carga).\n2. iPhone: o CarPlay começa sozinho. Celular Android: desbloqueie-o e permita o Android Auto se ele pedir.\n\nO modo sem fio precisa do Bluetooth da multimídia, que os apps ainda não conseguem acessar nesta multimídia.</string>
    <string name="carlink_home_cable_ok">Entendi</string>
    <string name="carlink_home_error_usb_title">A conexão USB falhou</string>
    <string name="carlink_home_error_usb_body">Desbloqueie o celular e aceite o aviso dele. Se continuar falhando, tente outro cabo.</string>
